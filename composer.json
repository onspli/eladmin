{
    "name": "onspli/eladmin",
    "description": "CRUD admin interface in PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Ondřej Šplíchal",
            "email": "ondrej.splichal@gmail.com"
        }
    ],
    "require": {
        "php" : "^8.1",
        "gettext/gettext": "^4.8",
        "monolog/monolog": "^2.9 || ^3.0",
        "jenssegers/blade": "^2.0"
    },
    "suggest":{
        "illuminate/database": "Allows using Eloquent as a standalone package."
    },
    "autoload": {
        "psr-4": {
            "Onspli\\Eladmin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onspli\\Eladmin\\Tests\\Unit\\": "tests/unit",
            "Onspli\\Eladmin\\Tests\\Integration\\": "tests/integration"
        }
    },
    "require-dev": {
        "illuminate/database": "^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:unit": "phpunit --testdox --testsuite unit",
        "test:integration": "phpunit --testdox --testsuite integration",
        "docs:install": "php -r \"copy('https://doctum.long-term.support/releases/5.6/doctum.phar', 'doctum.phar');\"",
        "docs:build": "rm -rf docs && php doctum.phar update doctum.config.php --force"
    },
    "archive": {
        "exclude": ["/docs", "/docs-theme", "/examples", "/screenshots", "/tests", "/_config.yml", "/doctum.config.php", "/.github", "/.gitignore"]
    }
}
